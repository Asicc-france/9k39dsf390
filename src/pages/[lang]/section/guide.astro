          <table>
            <thead><tr><th>{L(lang, { ko: '용어', fr: 'Terme' })}</th><th>{L(lang, { ko: '뜻', fr: 'Définition' })}</th></tr></thead>
            <tbody>{GLOSSARY.map(([k, v]) => <tr><td><b>{k}</b></td><td>{L(lang, v)}</td></tr>)}</tbody>
          </table>
        </div>
        <p>{L(lang, { ko: '학교생활에 관한 질문은 협회 학교급 대표가 경험을 바탕으로 안내해 드립니다.', fr: 'Les représentants de niveau de l’association répondent volontiers à vos questions.' })} <a href={href(lang, 'contact/')}>{L(lang, { ko: '문의하기', fr: 'Nous écrire' })} →</a></p>
      </section>
