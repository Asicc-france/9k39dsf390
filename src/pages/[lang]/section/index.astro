---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Sources from '../../../components/Sources.astro';
import { langPaths, href, L, type Lang } from '../../../i18n/ui';
import { LEVELS } from '../../../data/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} rest="section/" title={L(lang, { ko: '국제섹션 안내', fr: 'La section internationale' })}>
  <PageHero lang={lang} eyebrow={L(lang, { ko: '국제섹션 안내', fr: 'La section' })}
    title={L(lang, { ko: '프랑스 공립학교 안의 한국어 과정', fr: 'Un cursus en coréen dans l’école publique' })}
    intro={L(lang, { ko: '국제섹션은 한국과 프랑스 교육부의 협약으로 2017년 9월 문을 열었습니다. 학생들은 프랑스 정규 교육과정을 모두 따르면서, 일부 교과를 한국어로 배웁니다. 한국 학생에게는 깊이 있는 프랑스어 교육을, 프랑스 학생에게는 한국어와 한국 문화를 익힐 기회를 주어 두 나라 대학 진학을 함께 준비하도록 돕는 것이 목표입니다.', fr: 'Ouverte en septembre 2017 dans le cadre d’un accord entre les ministères français et coréen, la section permet de suivre l’intégralité du programme français tout en recevant une partie des enseignements en coréen, avec pour horizon le bilinguisme et l’accès aux études supérieures dans les deux pays.' })} />

  <section class="wrap sec stack" style="gap:28px">
    {LEVELS.map((lv) => (
      <article id={lv.id} class="card" style="overflow:hidden;scroll-margin-top:96px">
        <div class="split" style="gap:0">
          <div class="ph" style={`background:${lv.tint};color:${lv.ink};flex:1 1 280px;min-height:220px`}>{L(lang, { ko: `[${lv.name.ko} 사진]`, fr: `[Photo ${lv.name.fr.toLowerCase()}]` })}</div>
          <div class="stack gap-12" style="flex:999 1 480px;padding:28px 32px">
            <span class="eyebrow">{lv.code}</span>
            <h2 class="h2">{L(lang, lv.name)}</h2>
            <p class="lead" style="font-size:16px">{L(lang, lv.desc)}</p>
            <div class="card card-pad small" style="background:var(--bg);border:0;padding:16px 18px">
              <div class="kv"><span class="muted">{L(lang, { ko: '학교', fr: 'Établissement' })}</span><b>{lv.school}</b></div>
              <div class="kv"><span class="muted">{L(lang, { ko: '주소', fr: 'Adresse' })}</span><span>{lv.address}</span></div>
              <div class="kv"><span class="muted">{L(lang, { ko: '한국어 수업', fr: 'Horaire en coréen' })}</span><span>{L(lang, lv.hours)}</span></div>
            </div>
            <ul class="small" style="padding-left:1.2em;color:var(--ink-2);display:grid;gap:4px">
              {lv.subjects.map((s) => <li>{L(lang, s)}</li>)}
            </ul>
          </div>
        </div>
      </article>
    ))}
    <p class="small muted">{L(lang, { ko: '유치원은 학습 기록장(carnet de suivi), 초등학교는 학생 통합 기록부(livret scolaire unique)로 한국어 학습을 함께 기록합니다. 중학교 과정 시수와 과목은 2019년 언론 보도 기준이므로, 현행 편성은 학교 안내로 확인해 주세요.', fr: 'Le suivi passe par le carnet de suivi (maternelle) et le livret scolaire unique (élémentaire). Les horaires du collège proviennent d’un article de 2019 et restent à confirmer.' })}</p>
  </section>

  <section class="band">
    <div class="wrap sec split">
      <div class="side">
        <span class="eyebrow">{L(lang, { ko: '한국어 국제섹션이 있는 곳', fr: 'Ailleurs en France' })}</span>
        <h2 class="h2">{L(lang, { ko: '쿠르브부아와 스트라스부르', fr: 'Courbevoie et Strasbourg' })}</h2>
      </div>
      <div class="main stack gap-16">
        <p class="lead" style="font-size:16px">{L(lang, { ko: '프랑스의 한국어 국제섹션은 쿠르브부아(유치원·초등학교·중학교)와 스트라스부르(Collège international Vauban) 두 곳에 있습니다. 두 곳의 교사 인건비는 같은 예산 체계로 운영됩니다.', fr: 'En France, la section coréenne existe à Courbevoie (maternelle, élémentaire, collège) et à Strasbourg (collège international Vauban), financées par un même dispositif.' })}</p>
        <div class="row gap-12">
          <a class="btn btn-accent" href={href(lang, 'admission/')}>{L(lang, { ko: '입학 안내', fr: 'Admissions' })}</a>
          <a class="btn btn-ghost" href={href(lang, 'section/guide/')}>{L(lang, { ko: '프랑스 학교생활 가이드', fr: 'Guide de la vie scolaire' })}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="wrap" style="padding:32px 24px 56px"><Sources lang={lang} /></div>
</Base>
